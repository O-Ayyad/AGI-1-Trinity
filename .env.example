# api, subscription or local
CLAUDE_BACKEND=subscription

# Needed for CLAUDE_BACKEND=api
ANTHROPIC_API_KEY=

# Needed for CLAUDE_BACKEND=subscription (claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-opus-5-5

LOCAL_MODEL=llama3.1
LOCAL_API_KEY=

# workflow runs the Planner, Coder and Tester. coder runs the Coder alone in ./workspace. ack only acknowledges the prompt.
TRINITY_AGENT=workflow
